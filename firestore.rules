rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: categories
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required)
    //   - icon: string (required)
    //   - color: string (required)
    //   - budget: number (optional)
    //   - uid: string (required) - owner of the category
    //
    // Collection: expenses
    // Document ID: auto-generated
    // Fields:
    //   - amount: number (required)
    //   - description: string (required)
    //   - date: string (required, ISO 8601)
    //   - categoryId: string (required)
    //   - uid: string (required) - owner of the expense
    //
    // Collection: incomes
    // Document ID: auto-generated
    // Fields:
    //   - amount: number (required)
    //   - description: string (required)
    //   - date: string (required, ISO 8601)
    //   - source: string (required)
    //   - uid: string (required) - owner of the income
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }
    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }
    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidCategory(data) {
      return hasRequiredFields(['name', 'icon', 'color', 'uid']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.icon is string && data.icon.size() > 0 &&
             data.color is string && data.color.matches("^#[0-9a-fA-F]{6}$");
    }

    function isValidExpense(data) {
      return hasRequiredFields(['amount', 'description', 'date', 'categoryId', 'uid']) &&
             data.amount is number && data.amount >= 0 &&
             data.description is string && data.description.size() > 0 && data.description.size() < 500 &&
             data.date is string && data.date.matches("^\\d{4}-\\d{2}-\\d{2}.*") &&
             data.categoryId is string;
    }

    function isValidIncome(data) {
      return hasRequiredFields(['amount', 'description', 'date', 'source', 'uid']) &&
             data.amount is number && data.amount >= 0 &&
             data.description is string && data.description.size() > 0 && data.description.size() < 500 &&
             data.date is string && data.date.matches("^\\d{4}-\\d{2}-\\d{2}.*") &&
             data.source is string;
    }

    // ===============================================================
    // Match Rules
    // ===============================================================

    match /categories/{categoryId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidCategory(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidCategory(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner();
    }

    match /expenses/{expenseId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidExpense(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidExpense(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner();
    }

    match /incomes/{incomeId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidIncome(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidIncome(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner();
    }
  }
}
